{
  "schemaVersion": "meta-ads-personal-feed-sources/v5",
  "policies": {
    "persistRawResponseBody": false,
    "historyRetentionDays": 180,
    "maxPublishedItems": 100,
    "freshness": {
      "maxItemAgeDays": 365
    },
    "bilingualPresentation": {
      "maxRequestsPerRun": 12,
      "maxInputChars": 4000,
      "shortHeadlineMaxChars": 80,
      "summaryMaxChars": 360,
      "minRequestIntervalSeconds": 12,
      "maxAttempts": 3,
      "maxRetryDelaySeconds": 60
    }
  },
  "sources": [
    {
      "id": "meta-product-news-rss",
      "name": "Meta Newsroom Product News",
      "classification": "official",
      "sourceUrl": "https://about.fb.com/news/category/product-news/",
      "fetchUrl": "https://about.fb.com/news/category/product-news/feed/",
      "parser": "rss",
      "expectedContentTypes": ["application/rss+xml", "application/xml", "text/xml"],
      "contentLanguage": "en",
      "platforms": ["Metaプラットフォーム全般"],
      "platformIds": ["meta-platforms"],
      "relevanceRevision": "meta-ads-v1",
      "transport": {
        "allowedFetchHosts": ["about.fb.com"],
        "allowedContentHosts": ["about.fb.com"],
        "maxResponseBytes": 1048576,
        "maxRedirects": 3,
        "maxItems": 50
      },
      "match": {
        "kind": "any_terms",
        "terms": [
          "meta ads",
          "facebook ads",
          "instagram ads",
          "advertising",
          "advertiser",
          "ads manager",
          "ad set",
          "marketing api",
          "business sdk",
          "conversion api",
          "conversions api",
          "meta pixel",
          "facebook pixel",
          "audience network",
          "advantage+"
        ]
      }
    },
    {
      "id": "meta-business-sdk-releases",
      "name": "Meta Business SDK Releases",
      "classification": "official",
      "sourceUrl": "https://github.com/facebook/facebook-nodejs-business-sdk/releases",
      "fetchUrl": "https://api.github.com/repos/facebook/facebook-nodejs-business-sdk/releases",
      "parser": "github_releases",
      "expectedContentTypes": ["application/json"],
      "contentLanguage": "en",
      "platforms": ["Meta Business SDK", "Marketing API"],
      "platformIds": ["meta-business-sdk", "marketing-api"],
      "relevanceRevision": "legacy-v2",
      "transport": {
        "allowedFetchHosts": ["api.github.com"],
        "allowedContentHosts": ["github.com"],
        "maxResponseBytes": 1048576,
        "maxRedirects": 3,
        "maxItems": 50
      },
      "match": {"kind": "all"}
    },
    {
      "id": "social-media-today-meta-ads",
      "name": "Social Media Today (Meta Ads)",
      "classification": "unofficial",
      "sourceUrl": "https://www.socialmediatoday.com/",
      "fetchUrl": "https://www.socialmediatoday.com/feeds/news/",
      "parser": "rss",
      "expectedContentTypes": ["application/rss+xml", "application/xml", "text/xml"],
      "contentLanguage": "en",
      "platforms": ["Meta Ads"],
      "platformIds": ["meta-ads"],
      "relevanceRevision": "legacy-v2",
      "transport": {
        "allowedFetchHosts": ["www.socialmediatoday.com"],
        "allowedContentHosts": ["www.socialmediatoday.com"],
        "maxResponseBytes": 1048576,
        "maxRedirects": 3,
        "maxItems": 50
      },
      "match": {
        "kind": "all_groups",
        "groups": [
          ["meta", "facebook", "instagram"],
          ["marketing api", "ads manager", "advertising", "advertiser", "campaign", "promotion", "ads", "ad"]
        ]
      }
    },
    {
      "id": "jon-loomer-meta-ads",
      "name": "Jon Loomer Digital",
      "classification": "unofficial",
      "sourceUrl": "https://www.jonloomer.com/",
      "fetchUrl": "https://www.jonloomer.com/feed/",
      "parser": "rss",
      "expectedContentTypes": ["application/rss+xml", "application/xml", "text/xml"],
      "contentLanguage": "en",
      "platforms": ["Meta Ads"],
      "platformIds": ["meta-ads"],
      "relevanceRevision": "legacy-v2",
      "transport": {
        "allowedFetchHosts": ["www.jonloomer.com"],
        "allowedContentHosts": ["www.jonloomer.com"],
        "maxResponseBytes": 2097152,
        "maxRedirects": 3,
        "maxItems": 50
      },
      "match": {"kind": "rss_category", "categories": ["Meta Advertising"]}
    }
  ],
  "discoveredSources": [
    {
      "id": "meta-business-news-discovered",
      "name": "Meta for Business News",
      "classification": "official",
      "sourceUrl": "https://www.facebook.com/business/news/",
      "parser": "meta_business_news_html",
      "expectedContentTypes": ["text/html"],
      "contentLanguage": "en",
      "platforms": ["Meta Ads"],
      "platformIds": ["meta-ads"],
      "relevanceRevision": "legacy-v2",
      "transport": {
        "allowedFetchHosts": ["www.facebook.com"],
        "allowedContentHosts": ["www.facebook.com"],
        "maxResponseBytes": 1048576,
        "maxRedirects": 3,
        "maxItems": 20
      },
      "discovery": {
        "fromSourceId": "jon-loomer-meta-ads",
        "allowedPathPrefix": "/business/news/",
        "maxLinksPerSourceItem": 10
      }
    }
  ]
}
