{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysmsnsmr.github.io/schemas/meta-ads-headline-translations/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {"const": "meta-ads-headline-translations/v1"},
    "items": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["zh-Hans", "es", "ko"],
        "properties": {
          "zh-Hans": {"$ref": "#/$defs/translation"},
          "es": {"$ref": "#/$defs/translation"},
          "ko": {"$ref": "#/$defs/translation"}
        }
      }
    }
  },
  "$defs": {
    "translation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value", "inputHash", "generatedAt", "error"],
      "properties": {
        "status": {"enum": ["machine", "missing"]},
        "value": {"type": ["string", "null"], "maxLength": 240},
        "inputHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generatedAt": {"type": ["string", "null"], "format": "date-time"},
        "error": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$", "maxLength": 64}
      },
      "oneOf": [
        {"properties": {"status": {"const": "machine"}, "value": {"type": "string", "minLength": 1}, "generatedAt": {"type": "string", "format": "date-time"}, "error": {"type": "null"}}},
        {"properties": {"status": {"const": "missing"}, "value": {"type": "null"}, "generatedAt": {"type": "null"}, "error": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
