{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysmsnsmr.github.io/schemas/meta-ads-personal-feed/v3",
  "title": "Meta Ads Personal Feed v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultLocale", "availableLocales", "generatedAt", "sources", "items"],
  "properties": {
    "schemaVersion": {"const": "meta-ads-personal-feed/v3"},
    "defaultLocale": {"const": "en"},
    "availableLocales": {"const": ["en", "ja"]},
    "generatedAt": {"type": ["string", "null"], "format": "date-time"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "classification", "sourceUrl", "contentLanguage", "platformIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "classification": {"enum": ["official", "unofficial"]},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "contentLanguage": {"const": "en"},
        "platformIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
      }
    },
    "locale": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "shortHeadline", "summary", "inputHash", "generatedAt", "reviewedAt"],
          "properties": {
            "status": {"const": "missing"},
            "shortHeadline": {"type": "null"},
            "summary": {"type": "null"},
            "inputHash": {"$ref": "#/$defs/hash"},
            "generatedAt": {"type": "null"},
            "reviewedAt": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "shortHeadline", "summary", "inputHash", "generatedAt", "reviewedAt"],
          "properties": {
            "status": {"const": "machine"},
            "shortHeadline": {"type": "string", "minLength": 1, "maxLength": 240},
            "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
            "inputHash": {"$ref": "#/$defs/hash"},
            "generatedAt": {"$ref": "#/$defs/timestamp"},
            "reviewedAt": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "shortHeadline", "summary", "inputHash", "generatedAt", "reviewedAt"],
          "properties": {
            "status": {"const": "reviewed"},
            "shortHeadline": {"type": "string", "minLength": 1, "maxLength": 240},
            "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
            "inputHash": {"$ref": "#/$defs/hash"},
            "generatedAt": {"$ref": "#/$defs/timestamp"},
            "reviewedAt": {"$ref": "#/$defs/timestamp"}
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourceFingerprint", "generatorRevision", "locales"],
      "properties": {
        "schemaVersion": {"const": "meta-ads-personal-feed-presentation/v2"},
        "sourceFingerprint": {"$ref": "#/$defs/hash"},
        "generatorRevision": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "locales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ja"],
          "properties": {"en": {"$ref": "#/$defs/locale"}, "ja": {"$ref": "#/$defs/locale"}}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "title", "url", "publishedDate", "updatedDate", "firstObservedAt", "lastObservedAt", "platformIds", "matchEvidence", "presentation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publishedDate": {"$ref": "#/$defs/date"},
        "updatedDate": {"$ref": "#/$defs/date"},
        "firstObservedAt": {"$ref": "#/$defs/timestamp"},
        "lastObservedAt": {"$ref": "#/$defs/timestamp"},
        "platformIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "matchEvidence": {"type": "array", "items": {"type": "string"}},
        "presentation": {"$ref": "#/$defs/presentation"}
      }
    }
  }
}
