{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysmsnsmr.github.io/schemas/meta-ads-tracker-candidate/v2",
  "title": "Meta Ads daily change candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateHash",
    "generatedAt",
    "baseline",
    "week",
    "sourceRuns",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": "meta-ads-tracker-candidates/v2" },
    "candidateHash": { "$ref": "#/$defs/hash" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cutoffAt"],
      "properties": {
        "mode": { "enum": ["seeded", "active"] },
        "cutoffAt": { "type": "string", "format": "date-time" }
      }
    },
    "week": { "$ref": "#/$defs/week" },
    "sourceRuns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "status", "fetchedAt"],
        "properties": {
          "sourceId": { "$ref": "#/$defs/identifier" },
          "status": { "const": "success" },
          "fetchedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateItem" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "label"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "dateFact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "stated" },
            "value": { "type": "string", "format": "date" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "not_stated" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "textFact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "stated" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "not_stated" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "emptyImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "assessmentSource"],
      "properties": {
        "status": { "const": "not_stated" },
        "summary": { "type": "null" },
        "assessmentSource": { "type": "null" }
      }
    },
    "candidateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "subjectId",
        "revision",
        "sourceFingerprint",
        "detectedAt",
        "changeType",
        "sourceId",
        "title",
        "officialUrl",
        "priority",
        "announcementDate",
        "effectiveDate",
        "rollout",
        "targets",
        "businessImpact",
        "action",
        "reviewStatus",
        "sourceContext"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "eventId": { "$ref": "#/$defs/identifier" },
        "subjectId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/hash" },
        "sourceFingerprint": { "$ref": "#/$defs/hash" },
        "originCandidateHash": { "$ref": "#/$defs/hash" },
        "detectedAt": { "type": "string", "format": "date-time" },
        "changeType": { "enum": ["new_url", "content_changed", "sdk_release"] },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "officialUrl": { "type": "string", "format": "uri" },
        "priority": { "enum": ["high", "standard", "low"] },
        "announcementDate": { "$ref": "#/$defs/dateFact" },
        "effectiveDate": { "$ref": "#/$defs/dateFact" },
        "rollout": { "$ref": "#/$defs/textFact" },
        "targets": { "$ref": "#/$defs/textFact" },
        "businessImpact": { "$ref": "#/$defs/emptyImpact" },
        "action": { "$ref": "#/$defs/emptyImpact" },
        "reviewStatus": { "const": "pending" },
        "sourceContext": { "type": "string", "maxLength": 3500 }
      }
    }
  }
}
