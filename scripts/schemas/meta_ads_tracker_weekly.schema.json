{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysmsnsmr.github.io/schemas/meta-ads-tracker-weekly-candidate/v1",
  "title": "Immutable Meta Ads weekly candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "weeklyHash",
    "generatedAt",
    "cutoffAt",
    "week",
    "candidateRefs",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": "meta-ads-tracker-weekly-candidate/v1" },
    "weeklyHash": { "$ref": "#/$defs/hash" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "cutoffAt": { "type": "string", "format": "date-time" },
    "week": { "$ref": "#/$defs/week" },
    "candidateRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileName", "candidateHash", "generatedAt"],
        "properties": {
          "fileName": {
            "type": "string",
            "pattern": "^[0-9TZ._-]+\\.json$"
          },
          "candidateHash": { "$ref": "#/$defs/hash" },
          "generatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://ysmsnsmr.github.io/schemas/meta-ads-tracker-candidate/v2#/$defs/candidateItem" },
          {
            "type": "object",
            "required": ["originCandidateHash"],
            "properties": {
              "originCandidateHash": { "$ref": "#/$defs/hash" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "label"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
