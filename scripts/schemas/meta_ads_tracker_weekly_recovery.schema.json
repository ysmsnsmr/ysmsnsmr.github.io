{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysmsnsmr.github.io/schemas/meta-ads-tracker-weekly-recovery/v1",
  "title": "Non-public recovery record for a delayed Meta Ads weekly assembly",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recoveryHash",
    "generatedAt",
    "cutoffAt",
    "week",
    "recoveryReason",
    "missingPreCutoffDates",
    "candidateRefs",
    "items",
    "publicationEligible",
    "requiresHumanDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": "meta-ads-tracker-weekly-recovery/v1" },
    "recoveryHash": { "$ref": "#/$defs/hash" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "cutoffAt": { "type": "string", "format": "date-time" },
    "week": { "$ref": "#/$defs/week" },
    "recoveryReason": { "const": "missing_pre_cutoff_coverage" },
    "missingPreCutoffDates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "date" }
    },
    "candidateRefs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileName", "candidateHash", "generatedAt", "timing"],
        "properties": {
          "fileName": { "type": "string", "pattern": "^[0-9TZ._-]+\\.json$" },
          "candidateHash": { "$ref": "#/$defs/hash" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "timing": { "enum": ["on_time", "late"] }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://ysmsnsmr.github.io/schemas/meta-ads-tracker-candidate/v3#/$defs/candidateItem" },
          {
            "type": "object",
            "required": ["originCandidateHash"],
            "properties": {
              "originCandidateHash": { "$ref": "#/$defs/hash" }
            }
          }
        ]
      }
    },
    "publicationEligible": { "const": false },
    "requiresHumanDisposition": { "const": true }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "label"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
